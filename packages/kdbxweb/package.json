{
  "name": "kdbxweb",
  "version": "2.2.0-nextkeeweb.1",
  "private": true,
  "description": "Fork of keeweb/kdbxweb maintained for NextKeeWeb, see FORK.md",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "FORK.md"],
  "scripts": {
    "build": "esbuild lib/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:fflate --sourcemap --outfile=dist/index.js && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.7.4"
  }
}
