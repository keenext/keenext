{
	"name": "nextkeeweb/nextkeeweb",
	"description": "KeePass (KDBX) password databases in Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"nextcloud/coding-standard": "^1.5",
		"nextcloud/ocp": "dev-stable33",
		"phpunit/phpunit": "^11.5",
		"vimeo/psalm": "^6.0"
	},
	"autoload": {
		"psr-4": {
			"OCA\\NextKeeWeb\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\NextKeeWeb\\Tests\\": "tests/php/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/",
			"NCU\\": "vendor/nextcloud/ocp/NCU/"
		}
	},
	"scripts": {
		"test": "phpunit -c tests/php/phpunit.xml",
		"psalm": "psalm --no-cache --threads=1",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.2.27"
		}
	}
}
