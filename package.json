{
  "name": "keepassweb",
  "version": "0.1.0",
  "private": true,
  "description": "KeePass (KDBX) password databases in Nextcloud",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "vite build --mode production",
    "dev": "vite build --mode development",
